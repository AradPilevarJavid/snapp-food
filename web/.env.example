# Public build-time settings. These values are embedded in browser assets.
# Configure only after the API and identity provider registrations exist.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_OIDC_AUTHORITY=
NEXT_PUBLIC_OIDC_CLIENT_ID=
NEXT_PUBLIC_OIDC_RESOURCE=
NEXT_PUBLIC_CURRENCY=
# Path prefix when the site is served from a sub-path, for example /snap-food.
# Leave it empty for local development and for hosts serving from the root.
NEXT_PUBLIC_BASE_PATH=
