{
  "name": "snap-food-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.2.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && python3 scripts/generate_security_headers.py",
    "api:generate": "python3 scripts/generate_api_contract.py && openapi-typescript ../api/openapi.json -o src/api/generated/schema.d.ts && node scripts/generate_api_validators.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run api:generate && npm run lint && npm run typecheck && npm test && python3 scripts/test_security_headers.py && python3 scripts/test_deployment_pages.py && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.4",
    "next": "16.4.6",
    "oidc-client-ts": "^3.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.20.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5",
    "vitest": "^5.1.2",
    "vitest-axe": "^0.1.0"
  }
}
